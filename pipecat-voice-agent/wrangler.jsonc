{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realtime-pipecat-voice-agent",
  "main": "src/entry.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["python_workers"],
  "python_modules": { "exclude": ["**/*.pyc", "openai/**", "PIL/**", "**/*.pyi"] },
  // Uploads the typing loop next to the Python modules that read it.
  "rules": [{ "type": "Data", "globs": ["transport/*.wav"], "fallthrough": true }],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "durable_objects": { "bindings": [{ "name": "CALLS", "class_name": "VoiceCall" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceCall"] }],
  "ratelimits": [
    // Choose distinct account-local IDs so login and call limits have separate counters.
    { "name": "LOGIN_LIMITER", "namespace_id": "602601", "simple": { "limit": 10, "period": 60 } },
    { "name": "CALL_LIMITER", "namespace_id": "602602", "simple": { "limit": 5, "period": 60 } },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    // Traces show each subrequest (Durable Object, rate limiter, Realtime API) as a span.
    "traces": { "enabled": true },
  },
  // Previews inherit none of the bindings above. Each Preview gets its own CALLS namespace;
  // separate limiter IDs keep Preview traffic out of production's counters.
  "previews": {
    "ai": { "binding": "AI" },
    "durable_objects": { "bindings": [{ "name": "CALLS", "class_name": "VoiceCall" }] },
    "ratelimits": [
      {
        "name": "LOGIN_LIMITER",
        "namespace_id": "602611",
        "simple": { "limit": 10, "period": 60 },
      },
      { "name": "CALL_LIMITER", "namespace_id": "602612", "simple": { "limit": 5, "period": 60 } },
    ],
  },
}
